# =============================================================================
#  claude-web-skills-toolkit — .gitignore
#  Node.js projects, Claude Code configuration and local secrets
# =============================================================================

# --- Secrets and local environment -------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
.secrets/
secrets.json
credentials.json
service-account*.json
# May contain _authToken / registry credentials
.npmrc
.yarnrc
.pypirc
.netrc

# --- Claude Code: local (private) configuration ------------------------------
# Shared files (.claude/settings.json, .claude/skills/, .mcp.json without secrets)
# are committed. Personal and local variants are not.
.claude/settings.local.json
.claude/*.local.json
.claude/*.local.md
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/ide/
.claude/worktrees/
.claude/.credentials.json
CLAUDE.local.md
.mcp.local.json
.claude.json
.claude.json.backup

# Skill copies created by ./install.sh --skills when testing
# directly in this repository (the source of truth is the skills/ folder).
/.claude/skills/

# --- Node.js -----------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
web_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/
.npm/
.node_repl_history
*.tgz
.yarn-integrity

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Runtime data ------------------------------------------------------------
pids/
*.pid
*.seed
*.pid.lock

# --- Build output and framework caches ---------------------------------------
dist/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.astro/
.remix/
.vercel/
.netlify/
.turbo/
.vite/
.parcel-cache/
.cache/
.eslintcache
.stylelintcache
.tsbuildinfo
*.tsbuildinfo
next-env.d.ts
storybook-static/
.docusaurus/
.serverless/
.wrangler/
.dynamodb/

# --- Tests and coverage ------------------------------------------------------
coverage/
.nyc_output/
*.lcov
junit*.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
e2e/.auth/
.auth/

# --- Databases and local data ------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal
supabase/.branches/
supabase/.temp/

# --- Editors and IDEs --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*~
.history/
.fleet/
.zed/
*.sublime-workspace

# --- Operating systems -------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Temporary files ---------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
